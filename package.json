{
  "name": "sooda",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "description": "Know whether your profit survives restocking. Sooda is a profit, price and discount calculator for sellers: real profit after inflation, instalment pricing, your own product list, and a smart per-product price-growth estimate. Works offline, private, bilingual English/Persian.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "i18n:check": "node scripts/i18n-parity.mjs",
    "verify": "npm run typecheck && npm run test && npm run i18n:check && npm run docs:examples -- --check && npm run lesson:examples -- --check && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "shots:diff": "node scripts/screenshot-diff.mjs",
    "rates:update": "node scripts/rates/update.mjs",
    "rates:set": "node scripts/rates/set.mjs",
    "rates:cpi": "node scripts/rates/cpi.mjs",
    "rates:fallback": "node scripts/rates/fallback.mjs",
    "rates:test": "node --test scripts/rates/update.test.mjs",
    "docs:examples": "node scripts/docs-examples.mjs",
    "lesson:examples": "node scripts/lesson-examples.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^24.2.3",
    "motion": "^12.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright-core": "^1.52.0",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vazirmatn": "^33.0.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.1.4"
  }
}
