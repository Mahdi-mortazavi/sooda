    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright-core": "^1.52.0",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vazirmatn": "^33.0.3",
    "vite": "^6.3.5",
