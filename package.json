    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^24.2.3",
    "motion": "^12.15.0",
