{
  "name": "sooda",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Sooda — Liquid-glass profit, price & discount calculator. Offline-first PWA, bilingual (EN/FA), privacy-first.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
